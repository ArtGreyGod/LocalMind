<?xml version="1.0" encoding="utf-8"?>
<!--
   Same privacy policy as Auto Backup: conversations and indexed documents
   never leave the device, including device-to-device transfers and cloud
   restore flows. See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="engine_states/" />
        <exclude domain="database" path="localmind_studio.db" />
        <exclude domain="database" path="localmind_studio.db-wal" />
        <exclude domain="database" path="localmind_studio.db-shm" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="file" path="downloads/" />
        <exclude domain="file" path="engine_states/" />
        <exclude domain="database" path="localmind_studio.db" />
        <exclude domain="database" path="localmind_studio.db-wal" />
        <exclude domain="database" path="localmind_studio.db-shm" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
